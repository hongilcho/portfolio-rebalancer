# ========================================================
# Portfolio Rebalancer — Environment Variables Template
# ========================================================
# 본 파일은 환경 변수 템플릿입니다. 실제 비밀값은 여기에 넣지 마십시오.
# 로컬 개발 시에는 이 파일을 복사하여 .env 파일을 생성하십시오:
#   Windows: copy .env.example .env
#   Linux/Mac: cp .env.example .env

# --------------------------------------------------------
# 1. 백엔드 (FastAPI) 필수 환경 변수
# --------------------------------------------------------
# [필수 / Required] Supabase PostgreSQL 데이터베이스 접속 URL
# - Supabase 대시보드 > Project Settings > Database > Connection string 에서 복사
# - 트랜잭션 풀러(Transaction Pooler, 포트 6543) 권장 (또는 세션 풀러 포트 5432)
# - 형식 예시: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_URL=postgresql://postgres.[project-ref]:[password]@[host]:6543/postgres

# --------------------------------------------------------
# 2. 백엔드 (FastAPI) 선택 환경 변수
# --------------------------------------------------------
# [선택 / Optional] 웹 대시보드 로그인 비밀번호
# - 미설정 시 기본값 '1234'로 동작합니다.
APP_PASSWORD=1234

# [선택 / Optional] NH투자증권 Namuh PLUG Open API App Key
# - 계좌 자동 동기화(나무증권 잔고 가져오기) 및 실시간 금현물 시세 연동 시 사용됩니다.
# - 미설정 시에도 네이버 금융 JSON API 및 yfinance를 통해 모든 시세와 배당이 100% 정상 동작합니다.
NAMUH_APP_KEY=

# [선택 / Optional] NH투자증권 Namuh PLUG Open API App Secret
# - NH API 인증을 위한 비밀키입니다.
NAMUH_APP_SECRET=

# [선택 / Optional] 환율 Fallback 고정값 (기본값: 1380.0)
# - 외부 환율 API 일시 장애 시 시스템 안정성을 위해 적용할 기준 환율입니다.
DEFAULT_USD_KRW=1380.0

# [선택 / Optional] 백엔드 서버 바인딩 포트 (기본값: 8000)
# - Render 등 클라우드 플랫폼 배포 시 환경에서 자동 주입됩니다.
PORT=8000

# [선택] 종가 자동 기록: 기본값 1. 운영 DB를 사용하는 개발 서버는 반드시 0.
PERFORMANCE_CLOSE_SCHEDULER_ENABLED=1
# 거래소 달력 패키지에 아직 반영되지 않은 임시 휴장일 (ISO 날짜, 쉼표 구분)
PERFORMANCE_KRX_EXTRA_HOLIDAYS=
# 정규장 마감이 1시간 늦춰진 날짜 (2026-11-19는 코드에서 이미 반영)
PERFORMANCE_KRX_DELAYED_CLOSE_DATES=

# --------------------------------------------------------
# 3. 프론트엔드 (React / Vite) 환경 변수 (Vercel 배포 시 필수)
# --------------------------------------------------------
# [선택 / Optional] 백엔드 API 호스트 URL
# - 로컬 개발 시: 미설정 시 기본값 'http://localhost:8000'으로 백엔드 로컬 서버와 통신합니다.
# - Vercel 프로덕션 배포 시: 백엔드 Render URL을 지정해야 합니다 (예: https://portfolio-rebalancer-api.onrender.com)
VITE_API_BASE_URL=http://localhost:8000
